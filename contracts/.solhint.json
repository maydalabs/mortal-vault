{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": ["error", ">=0.8.28 <0.9.0"],
    "func-visibility": "off",
    "func-name-mixedcase": "off",
    "gas-indexed-events": "off",
    "gas-strict-inequalities": "off",
    "max-line-length": "off",
    "no-empty-blocks": "off",
    "use-natspec": "off"
  }
}
