{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mortal-vault.local/schemas/deployment-manifest.json",
  "title": "MortalVault deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "network",
    "deployment",
    "contract",
    "build",
    "verification"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "chainId"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "chainId": { "type": "integer", "minimum": 1 }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "futureId",
        "address",
        "transactionHash",
        "blockHash",
        "blockNumber"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "module": { "const": "MortalVaultModule" },
        "futureId": { "const": "MortalVaultModule#MortalVault" },
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "transactionHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "blockHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "blockNumber": { "type": "integer", "minimum": 0 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "constructorArguments",
        "creationBytecodeKeccak256",
        "runtimeBytecodeKeccak256"
      ],
      "properties": {
        "name": { "const": "MortalVault" },
        "source": { "const": "contracts/MortalVault.sol" },
        "constructorArguments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxVaultBalanceWei"],
          "properties": {
            "maxVaultBalanceWei": { "type": "string", "pattern": "^[1-9][0-9]*$" }
          }
        },
        "creationBytecodeKeccak256": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "runtimeBytecodeKeccak256": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "buildInfoId",
        "solcVersion",
        "optimizer",
        "gitCommit",
        "gitDirty"
      ],
      "properties": {
        "profile": { "const": "production" },
        "buildInfoId": { "type": "string", "minLength": 1 },
        "solcVersion": { "type": "string", "minLength": 1 },
        "optimizer": {
          "type": "object",
          "required": ["enabled", "runs"],
          "properties": {
            "enabled": { "const": true },
            "runs": { "type": "integer", "minimum": 1 }
          }
        },
        "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "gitDirty": { "type": "boolean" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "providers"],
      "properties": {
        "status": { "enum": ["pending", "verified"] },
        "providers": {
          "type": "array",
          "items": { "enum": ["etherscan", "sourcify"] },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
